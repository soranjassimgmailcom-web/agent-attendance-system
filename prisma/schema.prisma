generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum LeaveType {
  VACATION
  AUTHORIZED_ABSENCE
}

enum AgentJobRole {
  UNASSIGNED
  RECEPTION
  INFO_DESK_AUDIT
  WAREHOUSE
  SCAN
  TREASURY
  CENTER_TECHNICAL
  SIMULATION_ESTIMATION
}model TeamMessage {
  id        String   @id @default(cuid())
  senderId  String
  body      String   @default("")
  imageData Bytes?
  imageType String?
  createdAt DateTime @default(now())
  sender    User     @relation("TeamMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

teamMessages     TeamMessage[] @relation("TeamMessageSender")
  id               String       @id @default(cuid())
  name             String
  email            String       @unique
  password         String
  role             String       @default("AGENT")
  jobRole          AgentJobRole @default(UNASSIGNED)
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  attendance       Attendance[]
  leaveDays        LeaveDay[]
  activities       AgentActivity[]
  profileImage     Bytes?
  profileImageType String?
  sentAnnouncements Announcement[] @relation("AnnouncementSender")
  announcementReactions AnnouncementReaction[]
  announcementReads AnnouncementRead[]
  sentMessages     ChatMessage[] @relation("ChatMessageSender")
  receivedMessages ChatMessage[] @relation("ChatMessageReceiver")
}

model Attendance {
  id         String    @id @default(cuid())
  userId     String
  date       String
  checkInAt  DateTime?
  checkOutAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model LeaveDay {
  id        String    @id @default(cuid())
  userId    String
  date      String
  type      LeaveType
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
}

model AgentActivity {
  id        String   @id @default(cuid())
  userId    String
  date      String
  title     String
  details   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([date])
}

model Announcement {
  id        String                 @id @default(cuid())
  title     String
  message   String
  senderId  String
  createdAt DateTime               @default(now())
  sender    User                   @relation("AnnouncementSender", fields: [senderId], references: [id], onDelete: Restrict)
  reactions AnnouncementReaction[]
  reads     AnnouncementRead[]

  @@index([createdAt])
}

model AnnouncementReaction {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  reaction       String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([announcementId])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId, readAt])
}

model ChatMessage {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  body       String
  createdAt  DateTime @default(now())
  readAt     DateTime?
  sender     User     @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ChatMessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, readAt])
}
