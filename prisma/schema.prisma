generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum LeaveType {
  VACATION
  AUTHORIZED_ABSENCE
}

enum AgentJobRole {
  UNASSIGNED
  RECEPTION
  INFO_DESK_AUDIT
  WAREHOUSE
  SCAN
  TREASURY
  CENTER_TECHNICAL
  SIMULATION_ESTIMATION
}

model User {
  id               String       @id @default(cuid())
  name             String
  email            String       @unique
  password         String
  role             String       @default("AGENT")
  jobRole          AgentJobRole @default(UNASSIGNED)
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  attendance       Attendance[]
  leaveDays        LeaveDay[]
  activities       AgentActivity[]
  profileImage     Bytes?
  profileImageType String?
}

model Attendance {
  id         String    @id @default(cuid())
  userId     String
  date       String
  checkInAt  DateTime?
  checkOutAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model LeaveDay {
  id        String    @id @default(cuid())
  userId    String
  date      String
  type      LeaveType
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
}

model AgentActivity {
  id        String   @id @default(cuid())
  userId    String
  date      String
  title     String
  details   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([date])
}
